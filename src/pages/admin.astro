---
// src/pages/admin.astro — local admin panel for managing album cities & photos.
// No authentication: this page and the /api endpoints it calls are
// intended for local use only.
export const prerender = false;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Admin · Album</title>
		<style>
			:root { color-scheme: dark; }
			* { box-sizing: border-box; }
			body {
				margin: 0; background: #111111; color: #ffffff;
				font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
				font-size: 14px; line-height: 1.5;
			}
			h1, h2 { font-weight: 600; letter-spacing: -0.01em; }
			h2 { font-size: 16px; margin: 0 0 14px; color: #e6edf3; }
			a { color: #6cb6ff; }
			.wrap { max-width: 880px; margin: 0 auto; padding: 32px 20px 80px; }
			.card {
				background: #181818; border: 1px solid #2a2a2a; border-radius: 12px;
				padding: 22px; margin-bottom: 22px;
			}
			label { display: block; font-size: 12px; color: #9aa4ad; margin: 10px 0 4px; }
			input, select {
				width: 100%; padding: 9px 11px; background: #0d0d0d; color: #fff;
				border: 1px solid #2a2a2a; border-radius: 8px; font-size: 14px;
			}
			input:focus, select:focus { outline: none; border-color: #4a9eff; }
			button {
				background: #2563eb; color: #fff; border: none; border-radius: 8px;
				padding: 9px 16px; font-size: 14px; cursor: pointer; transition: background .15s;
			}
			button:hover { background: #1d4ed8; }
			button.secondary { background: #2a2a2a; }
			button.secondary:hover { background: #3a3a3a; }
			button.danger { background: #3a2222; color: #ff8d7a; }
			button.danger:hover { background: #4a2a2a; }
			.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
			.row > div { flex: 1; min-width: 140px; }
			.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
			.muted { color: #6e7681; font-size: 12px; }
			.list-item {
				display: flex; align-items: center; justify-content: space-between;
				gap: 12px; padding: 10px 12px; background: #0d0d0d;
				border: 1px solid #222; border-radius: 8px; margin-bottom: 8px;
			}
			.tag { color: #9aa4ad; font-size: 12px; }
			.photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; }
			.photo { position: relative; border-radius: 8px; overflow: hidden; border: 1px solid #222; }
			.photo img { width: 100%; height: 90px; object-fit: cover; display: block; }
			.photo button {
				position: absolute; top: 4px; right: 4px; padding: 2px 7px; font-size: 12px;
				background: rgba(0,0,0,.65); color: #ff8d7a;
			}
			#msg { min-height: 20px; font-size: 13px; margin-top: 8px; }
			.err { color: #ff8d7a; } .ok { color: #5ad19a; }
			hr { border: none; border-top: 1px solid #2a2a2a; margin: 18px 0; }
		</style>
	</head>
	<body>
		<!-- Admin app -->
		<div id="app" class="wrap">
			<h1 style="margin:0;">Album Admin</h1>
			<div id="msg"></div>

			<!-- City management -->
			<div class="card">
				<h2>Add City</h2>
				<div class="grid2">
					<div><label>City name</label><input id="c-name" placeholder="Paris" /></div>
					<div><label>Country</label><input id="c-country" placeholder="France" /></div>
				</div>
				<div class="row" style="margin-top:6px;">
					<div><label>Latitude</label><input id="c-lat" placeholder="0" /></div>
					<div><label>Longitude</label><input id="c-lon" placeholder="0" /></div>
					<div style="flex:0 0 auto;"><button id="geo-btn" class="secondary">📍 Lookup coords</button></div>
				</div>
				<div class="grid2" style="margin-top:6px;">
					<div><label>First year.month</label><input id="c-year" placeholder="2024.03" /></div>
				</div>
				<div style="margin-top:14px;"><button id="add-city-btn">Add city</button></div>
			</div>

			<div class="card">
				<h2>Cities</h2>
				<div id="city-list"></div>
			</div>

			<!-- Photo management -->
			<div class="card">
				<h2>Photos</h2>
				<div class="row">
					<div><label>City</label><select id="p-city"></select></div>
					<div><label>Year</label><select id="p-year"></select></div>
				</div>
				<hr />
				<div class="row">
					<div><label>Upload photos</label><input id="p-file" type="file" accept="image/*" multiple /></div>
					<div style="flex:0 0 auto;"><button id="upload-btn">Upload</button></div>
				</div>
				<div id="photo-grid" class="photos" style="margin-top:16px;"></div>
			</div>
		</div>

		<script>
			const $ = (id: string): any => document.getElementById(id);
			const msgEl = $('msg');

			let cities: any[] = [];

			// ── Messaging ──────────────────────────────────────────────
			function flash(text: string, isErr = false) {
				msgEl.textContent = text;
				msgEl.className = isErr ? 'err' : 'ok';
				if (text) setTimeout(() => { if (msgEl.textContent === text) msgEl.textContent = ''; }, 4000);
			}
			async function api(url: string, opts?: any) {
				const res = await fetch(url, opts);
				const data = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
				return data;
			}

			// ── Cities ─────────────────────────────────────────────────
			async function loadCities() {
				try {
					cities = await api('/api/cities');
					renderCityList();
					renderPhotoCitySelect();
				} catch (e: any) { flash(e.message, true); }
			}

			function renderCityList() {
				const el = $('city-list');
				if (!cities.length) { el.innerHTML = '<div class="muted">No cities yet.</div>'; return; }
				el.innerHTML = '';
				cities.forEach((c) => {
					const years = (c.years || []).map((y: any) => y.year).join(' · ') || '—';
					const div = document.createElement('div');
					div.className = 'list-item';
					div.innerHTML =
						`<div><strong>${c.name}</strong> <span class="tag">${c.country || ''}</span>` +
						`<br/><span class="tag">${c.lat}, ${c.lon} &nbsp;|&nbsp; ${years}</span></div>`;
					const btn = document.createElement('button');
					btn.className = 'danger';
					btn.textContent = 'Delete';
					btn.addEventListener('click', () => deleteCity(c.name));
					div.appendChild(btn);
					el.appendChild(div);
				});
			}

			$('geo-btn').addEventListener('click', async () => {
				const name = $('c-name').value.trim();
				const country = $('c-country').value.trim();
				if (!name) return flash('Enter a city name first', true);
				const q = country ? `${name}, ${country}` : name;
				try {
					const r = await api('/api/geocode?q=' + encodeURIComponent(q));
					$('c-lat').value = r.lat;
					$('c-lon').value = r.lon;
					flash(`Found: ${r.display || q}`);
				} catch (e: any) { flash(e.message, true); }
			});

			$('add-city-btn').addEventListener('click', async () => {
				const body = {
					name: $('c-name').value.trim(),
					country: $('c-country').value.trim(),
					lat: $('c-lat').value.trim(),
					lon: $('c-lon').value.trim(),
					year: $('c-year').value.trim(),
				};
				if (!body.name) return flash('City name required', true);
				try {
					const r = await api('/api/cities', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(body),
					});
					cities = r.cities;
					renderCityList(); renderPhotoCitySelect();
					['c-name', 'c-country', 'c-lat', 'c-lon', 'c-year'].forEach((id) => ($(id).value = ''));
					flash(`Added ${body.name}`);
				} catch (e: any) { flash(e.message, true); }
			});

			async function deleteCity(name: string) {
				if (!confirm(`Delete city "${name}"?`)) return;
				try {
					const r = await api('/api/cities', {
						method: 'DELETE',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ name }),
					});
					cities = r.cities;
					renderCityList(); renderPhotoCitySelect();
					flash(`Deleted ${name}`);
				} catch (e: any) { flash(e.message, true); }
			}

			// ── Photos ─────────────────────────────────────────────────
			function renderPhotoCitySelect() {
				const sel = $('p-city');
				const prev = sel.value;
				sel.innerHTML = cities.map((c) => `<option value="${c.name}">${c.name}</option>`).join('');
				if (cities.some((c) => c.name === prev)) sel.value = prev;
				renderPhotoYearSelect();
			}
			function renderPhotoYearSelect() {
				const city = cities.find((c) => c.name === $('p-city').value);
				const sel = $('p-year');
				const years = city ? (city.years || []) : [];
				sel.innerHTML = years.map((y: any) => `<option value="${y.year}">${y.year}</option>`).join('');
				renderPhotoGrid();
			}
			function renderPhotoGrid() {
				const city = cities.find((c) => c.name === $('p-city').value);
				const year = $('p-year').value;
				const yearObj = city?.years?.find((y: any) => y.year === year);
				const photos = yearObj?.photos || [];
				const grid = $('photo-grid');
				if (!photos.length) { grid.innerHTML = '<div class="muted">No photos for this year.</div>'; return; }
				grid.innerHTML = '';
				photos.forEach((p: any) => {
					const div = document.createElement('div');
					div.className = 'photo';
					div.innerHTML = `<img src="${p.src}" loading="lazy" />`;
					const btn = document.createElement('button');
					btn.textContent = '✕';
					btn.addEventListener('click', () => deletePhoto(city.name, year, p.src));
					div.appendChild(btn);
					grid.appendChild(div);
				});
			}
			$('p-city').addEventListener('change', renderPhotoYearSelect);
			$('p-year').addEventListener('change', renderPhotoGrid);

			$('upload-btn').addEventListener('click', async () => {
				const city = $('p-city').value;
				const year = $('p-year').value;
				const files = $('p-file').files;
				if (!city || !year) return flash('Select a city and year', true);
				if (!files.length) return flash('Choose at least one file', true);
				try {
					for (const file of files) {
						const fd = new FormData();
						fd.append('file', file);
						fd.append('city', city);
						fd.append('year', year);
						const r = await api('/api/photos', { method: 'POST', body: fd });
						cities = r.cities;
					}
					$('p-file').value = '';
					renderPhotoGrid();
					flash(`Uploaded ${files.length} photo(s)`);
				} catch (e: any) { flash(e.message, true); }
			});

			async function deletePhoto(city: string, year: string, src: string) {
				if (!confirm('Delete this photo?')) return;
				try {
					const r = await api('/api/photos', {
						method: 'DELETE',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ city, year, src }),
					});
					cities = r.cities;
					renderPhotoGrid();
					flash('Photo deleted');
				} catch (e: any) { flash(e.message, true); }
			}

			// ── Boot ───────────────────────────────────────────────────
			loadCities();
		</script>
	</body>
</html>
